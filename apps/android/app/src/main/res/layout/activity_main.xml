<?xml version="1.0" encoding="utf-8"?>
<!-- Three layers: the office, a print window above it, and the lock screen above everything. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/brand"
        android:visibility="gone" />

    <!-- Print window: the office opens proformas and job orders here -->
    <LinearLayout
        android:id="@+id/popup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <Button
                android:id="@+id/popupClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/close"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/popupPrint"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="@color/brand"
                android:text="@string/print"
                android:textAllCaps="false"
                android:textColor="@color/surface" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/popupHolder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Lock screen: covers the office until the phone confirms it is the owner -->
    <LinearLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lock_title"
            android:textColor="@color/brand_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/lock_message"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/unlock"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/brand"
            android:minWidth="180dp"
            android:text="@string/unlock"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="16sp" />

        <Button
            android:id="@+id/settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_settings"
            android:textAllCaps="false"
            android:textColor="@color/brand"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
