<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same brand colours as the website and office (apps/web/src/styles/global.css) -->
    <color name="brand">#1A73E8</color>
    <color name="brand_dark">#0B1A3A</color>
    <color name="surface">#FFFFFF</color>
    <color name="muted">#475569</color>
    <color name="line">#E2E8F0</color>

    <style name="Theme.TeamAdvert" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
