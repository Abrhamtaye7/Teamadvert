# public_html/office/.htaccess — the office app is a single-page app: unknown paths load index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /office/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /office/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Private app: keep it out of search engines
  Header set X-Robots-Tag "noindex, nofollow"
  # index.html must always be fresh so new deploys load; hashed assets can be cached for a year
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
