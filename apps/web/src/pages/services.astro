---
import { ArrowRight } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import ServicePicture from "../components/ServicePicture.astro";
import { SITE } from "../content/site";

const tones = ["blue", "orange", "navy"] as const;
---

<Base title="Services" description={`${SITE.services.map((s) => s.title).join(", ")} — from ${SITE.name} in Addis Ababa.`}>
  <section class="bg-brand-700 py-14 text-white md:py-20">
    <div class="container-site">
      <h1 class="text-4xl font-bold tracking-tight">Our services</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-100">Everything you need to advertise your business — designed, produced and installed by one team.</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Jump to a service">
        {SITE.services.map((s) => <a href={`#${s.slug}`} class="rounded-full bg-white/10 px-3 py-1.5 text-sm ring-1 ring-white/20 hover:bg-white/20">{s.title}</a>)}
      </nav>
    </div>
  </section>

  <div class="py-12 md:py-16">
    {
      SITE.services.map((s, i) => (
        <section id={s.slug} class:list={["scroll-mt-20 py-10 md:py-14", i % 2 === 1 && "bg-slate-50"]} aria-labelledby={`${s.slug}-title`}>
          <div class="container-site">
            <div class="grid items-center gap-8 md:grid-cols-2">
              <div class:list={["overflow-hidden rounded-2xl shadow-sm", i % 2 === 1 && "md:order-2"]}>
                <ServicePicture photoKey={s.slug} icon={s.icon} alt={s.title} tone={tones[i % 3]} />
              </div>
              <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-accent-500">{String(i + 1).padStart(2, "0")}</p>
                <h2 id={`${s.slug}-title`} class="mt-1 text-3xl font-bold tracking-tight">{s.title}</h2>
                <p class="mt-3 text-lg text-slate-600">{s.summary}</p>
                <a href="/contact/#quote" class="mt-5 inline-flex items-center gap-1.5 font-semibold text-brand-600 hover:underline">Get a quote <ArrowRight class="size-4" /></a>
              </div>
            </div>
            <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
              {s.items.map((item, j) => (
                <li class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                  <ServicePicture photoKey={`${s.slug}--${item.slug}`} icon={item.icon} alt={item.title} tone={tones[(i + j + 1) % 3]} size="sm" />
                  <p class="p-3 text-sm font-medium">{item.title}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="pb-16">
    <div class="container-site text-center">
      <p class="text-lg text-slate-700">Don't see exactly what you need? We probably make it.</p>
      <a href="/contact/#quote" class="mt-4 inline-flex h-12 items-center gap-2 rounded-lg bg-accent-500 px-6 font-semibold text-white hover:bg-accent-600">Ask us <ArrowRight class="size-4" /></a>
    </div>
  </section>
</Base>
