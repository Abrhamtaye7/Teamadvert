---
import { ArrowRight, Check } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import { SITE } from "../content/site";
---

<Base title="Services" description={`Signage, banners, vehicle branding, printing, design and promotional items from ${SITE.name} in Addis Ababa.`}>
  <section class="bg-brand-700 py-14 text-white md:py-20">
    <div class="container-site">
      <h1 class="text-4xl font-bold tracking-tight">Our services</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-100">Everything you need to advertise your business — designed, produced and installed by one team.</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-site space-y-6">
      {
        SITE.services.map((s, i) => (
          <article id={s.slug} class="scroll-mt-24 grid gap-6 rounded-2xl border border-slate-200 p-6 md:grid-cols-[auto_1fr_1fr] md:items-start md:p-8">
            <span class:list={["inline-flex w-fit rounded-xl p-4", i % 2 ? "bg-accent-50 text-accent-600" : "bg-brand-50 text-brand-600"]}>
              <ServiceIcon name={s.icon} class="size-8" />
            </span>
            <div>
              <h2 class="text-2xl font-semibold">{s.title}</h2>
              <p class="mt-2 text-slate-600">{s.summary}</p>
            </div>
            <ul class="grid gap-2 text-sm">
              {s.points.map((p) => (
                <li class="flex items-start gap-2">
                  <Check class="mt-0.5 size-4 shrink-0 text-emerald-600" /> {p}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="pb-16">
    <div class="container-site text-center">
      <p class="text-lg text-slate-700">Don't see exactly what you need? We probably make it.</p>
      <a href="/contact/#quote" class="mt-4 inline-flex h-12 items-center gap-2 rounded-lg bg-accent-500 px-6 font-semibold text-white hover:bg-accent-600">Ask us <ArrowRight class="size-4" /></a>
    </div>
  </section>
</Base>
