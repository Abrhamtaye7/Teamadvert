---
import { ArrowRight } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import ServicePicture from "../components/ServicePicture.astro";
import { SERVICE_KEYWORDS, serviceUrl } from "../content/seo";
import { SITE } from "../content/site";

const tones = ["blue", "orange", "navy"] as const;
const keywords = Object.values(SERVICE_KEYWORDS).map((k) => k.en[0]);
---

<Base
  title="Signs, banners, printing & branding services in Addis Ababa"
  description={`Signs, banners, vehicle wraps, printing, stickers, event and office branding, design, gifts and laser engraving by ${SITE.name}, Addis Ababa.`}
  keywords={keywords}
>
  <PageHero eyebrow="What we do" title="Everything your brand needs," highlight="under one roof" intro="Everything you need to advertise your business — designed, produced and installed by one team.">
    <!-- One swipeable row on phones, wrapped chips from small tablets up -->
    <nav class="fade-up -mx-4 mt-8 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0" style="--delay:.3s" aria-label="Jump to a service">
      {
        SITE.services.map((s) => (
          <a href={`#${s.slug}`} class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-full bg-white px-4 text-sm font-medium text-slate-700 ring-1 ring-slate-200 transition hover:text-brand-700 hover:ring-brand-300">
            {s.title}
          </a>
        ))
      }
    </nav>
  </PageHero>

  {
    SITE.services.map((s, i) => (
      <section id={s.slug} class:list={["scroll-mt-24 py-12 md:py-16", i % 2 === 1 && "bg-slate-50"]} aria-labelledby={`${s.slug}-title`}>
        <div class="container-site">
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            <div class:list={["reveal reveal-zoom overflow-hidden rounded-3xl shadow-xl shadow-slate-300/40", i % 2 === 1 && "md:order-2"]}>
              <ServicePicture photoKey={s.slug} icon={s.icon} alt={s.title} tone={tones[i % 3]} />
            </div>
            <div class="reveal" style="--i:1">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">
                {String(i + 1).padStart(2, "0")} · {s.items.length} options
              </p>
              <h2 id={`${s.slug}-title`} class="mt-2 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-4xl">
                {s.title}
              </h2>
              <p class="mt-3 text-lg text-slate-600">{s.summary}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href="/contact/#quote" class="inline-flex h-12 items-center gap-2 rounded-full bg-brand-600 px-6 font-semibold text-white transition hover:bg-brand-700">
                  Get a quote <ArrowRight class="size-4" aria-hidden="true" />
                </a>
                <a href={serviceUrl(s.slug)} class="inline-flex h-12 items-center gap-2 rounded-full bg-white px-6 font-semibold text-brand-950 ring-1 ring-slate-200 transition hover:ring-brand-300">
                  More about {s.title.toLowerCase()}
                </a>
              </div>
            </div>
          </div>
          <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-5">
            {s.items.map((item, j) => (
              <li class="reveal group h-full rounded-3xl bg-white p-3 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl" style={`--i:${j % 5}`}>
                <div class="zoom-media overflow-hidden rounded-2xl">
                  <ServicePicture photoKey={`${s.slug}--${item.slug}`} icon={item.icon} alt="" tone={tones[(i + j + 1) % 3]} size="sm" />
                </div>
                <p class="px-1 pb-1 pt-3 text-sm font-semibold leading-snug text-brand-950">{item.title}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="pb-4 text-center">
    <a href="/products/" class="inline-flex h-12 items-center gap-2 rounded-full bg-white px-6 font-semibold text-brand-950 ring-1 ring-slate-200 transition hover:ring-brand-300">
      See every product and production method <ArrowRight class="size-4" aria-hidden="true" />
    </a>
  </section>

  <CtaBand title="Don't see exactly what you need?" text="We probably make it. Send us the size, quantity and deadline and we'll reply with a proforma." />
</Base>
