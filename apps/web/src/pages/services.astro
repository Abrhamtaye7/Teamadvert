---
import { ArrowRight } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import ServicePicture from "../components/ServicePicture.astro";
import { SITE } from "../content/site";

const tones = ["blue", "orange", "navy"] as const;
---

<Base title="Services" description={`${SITE.services.map((s) => s.title).join(", ")} — from ${SITE.name} in Addis Ababa.`}>
  <section class="relative overflow-hidden bg-brand-950 py-16 text-white md:py-24"><div data-parallax="0.2" class="pointer-events-none absolute -right-32 -top-32 size-[28rem] rounded-full bg-brand-600/40 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative">
      <h1 class="display !text-[clamp(2.4rem,6vw,4.5rem)]"><span class="rise-word">Our</span> <span class="rise-word text-accent-400" style="--i:1">services</span></h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-100">Everything you need to advertise your business — designed, produced and installed by one team.</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Jump to a service">
        {SITE.services.map((s) => <a href={`#${s.slug}`} class="inline-flex min-h-11 items-center rounded-full bg-white/10 px-4 text-sm ring-1 ring-white/20 transition-colors hover:bg-white/20">{s.title}</a>)}
      </nav>
    </div>
  </section>

  <div class="py-12 md:py-16">
    {
      SITE.services.map((s, i) => (
        <section id={s.slug} class:list={["scroll-mt-20 py-10 md:py-14", i % 2 === 1 && "bg-slate-50"]} aria-labelledby={`${s.slug}-title`}>
          <div class="container-site">
            <div class="grid items-center gap-8 md:grid-cols-2">
              <div class:list={["reveal reveal-zoom overflow-hidden rounded-3xl shadow-lg", i % 2 === 1 && "md:order-2"]}>
                <ServicePicture photoKey={s.slug} icon={s.icon} alt={s.title} tone={tones[i % 3]} />
              </div>
              <div class="reveal" style="--i:1">
                <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">{String(i + 1).padStart(2, "0")}</p>
                <h2 id={`${s.slug}-title`} class="mt-1 text-3xl font-bold tracking-tight">{s.title}</h2>
                <p class="mt-3 text-lg text-slate-600">{s.summary}</p>
                <a href="/contact/#quote" class="mt-5 inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:underline">Get a quote <ArrowRight class="size-4" /></a>
              </div>
            </div>
            <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
              {s.items.map((item, j) => (
                <li class="reveal group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-shadow duration-300 hover:shadow-lg" style={`--i:${j}`}>
                  <div class="zoom-media overflow-hidden">
                  <ServicePicture photoKey={`${s.slug}--${item.slug}`} icon={item.icon} alt="" tone={tones[(i + j + 1) % 3]} size="sm" />
                  </div>
                  <p class="p-3 text-sm font-medium">{item.title}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="pb-16">
    <div class="container-site text-center">
      <p class="text-lg text-slate-700">Don't see exactly what you need? We probably make it.</p>
      <a href="/contact/#quote" class="mt-4 inline-flex h-12 items-center gap-2 rounded-lg bg-accent-500 px-6 font-semibold text-brand-950 hover:bg-accent-600">Ask us <ArrowRight class="size-4" /></a>
    </div>
  </section>
</Base>
