---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="py-24">
    <div class="container-site text-center">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">Error 404</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-4xl">We couldn't find <span class="text-brand-600">that page</span></h1>
      <p class="mt-3 text-slate-600">It may have moved. Try one of these instead:</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex h-12 items-center rounded-full bg-brand-600 px-6 font-semibold text-white hover:bg-brand-700">Home</a>
        <a href="/services/" class="inline-flex h-12 items-center rounded-full bg-white px-6 font-semibold text-brand-950 ring-1 ring-slate-200 hover:ring-brand-300">Services</a>
        <a href="/contact/" class="inline-flex h-12 items-center rounded-full bg-white px-6 font-semibold text-brand-950 ring-1 ring-slate-200 hover:ring-brand-300">Contact</a>
      </div>
    </div>
  </section>
</Base>
