---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="py-24">
    <div class="container-site text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-500">404</p>
      <h1 class="mt-2 text-3xl font-bold">We couldn't find that page</h1>
      <p class="mt-3 text-slate-600">It may have moved. Try one of these instead:</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-lg bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">Home</a>
        <a href="/services/" class="rounded-lg border border-slate-300 px-5 py-3 font-semibold hover:bg-slate-50">Services</a>
        <a href="/contact/" class="rounded-lg border border-slate-300 px-5 py-3 font-semibold hover:bg-slate-50">Contact</a>
      </div>
    </div>
  </section>
</Base>
