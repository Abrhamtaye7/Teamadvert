---
// Home page. Section order is inspired by print-shop storefronts: hero, benefits, steps, product strip,
// categories, popular products, promo pair, reasons, bulk-order banner, numbers.
// Every fact shown comes from src/content/site.ts — edit that file, not this one.
import { Picture } from "astro:assets";
import {
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  Clock3,
  FileText,
  Hammer,
  MessageCircle,
  Palette,
  Pause,
  Phone,
  Play,
  Send,
  ShieldCheck,
  Trophy,
  Wrench,
} from "@lucide/astro";
import * as Icons from "@lucide/astro";
import hero from "../assets/hero-showcase.jpg";
import Base from "../layouts/Base.astro";
import ServicePicture from "../components/ServicePicture.astro";
import { SITE, telegramHref, telHref, whatsappHref } from "../content/site";

const [mainPhone] = SITE.contact.phones;
const service = (slug: string) => SITE.services.find((s) => s.slug === slug)!;
const iconFor = (name: string) => (Icons as unknown as Record<string, typeof Icons.Image>)[name.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase())] ?? Icons.Image;

const headline = ["Signs,", "print", "&", "branding", "that", "make", "you"];
const highlight = ["impossible", "to", "miss."];

const benefits = [
  { icon: FileText, title: "Clear proforma with VAT" },
  { icon: Trophy, title: `${SITE.stats[0]?.value ?? ""} years in business` },
  { icon: BadgeCheck, title: `${SITE.stats[1]?.value ?? ""} jobs completed` },
  { icon: MessageCircle, title: "Quotes by WhatsApp & Telegram" },
];

const stepIcons = ["message-square-text", "file-text", "pen-tool", "truck"];
const stepTones = ["bg-brand-50 text-brand-700", "bg-accent-50 text-accent-700", "bg-emerald-50 text-emerald-700", "bg-sky-50 text-sky-700"];

// Category collage on the left of "Top categories"
const collage = [service("signage"), service("vehicle-branding"), service("promotional")];

// "Popular products": [service slug, sub-service slug]
const popular = [
  ["signage", "3d-letters"],
  ["large-format", "roll-ups"],
  ["vehicle-branding", "full-wraps"],
  ["printing", "business-cards"],
  ["stickers", "product-labels"],
  ["promotional", "apparel"],
  ["promotional", "mugs"],
  ["promotional", "bags"],
].map(([s, i]) => ({ service: service(s), item: service(s).items.find((x) => x.slug === i)! }));

const reasons = [
  { icon: Palette, title: "In-house design", text: "Our designers prepare and adjust your artwork before anything is printed." },
  { icon: BadgeCheck, title: "Clear proformas", text: "Itemised prices with VAT, so you know the cost before you commit." },
  { icon: ShieldCheck, title: "Quality materials", text: "Outdoor-grade inks, vinyls and frames that survive sun and rain." },
  { icon: Wrench, title: "Installation included", text: "Our team mounts signs, wraps vehicles and sets up event displays." },
  { icon: Clock3, title: "On-time delivery", text: "Agreed deadlines tracked from approval to handover." },
  { icon: Hammer, title: "Support after the job", text: "Repairs, replacements and re-prints when you need them." },
];
const reasonTones = ["text-brand-700 bg-brand-50", "text-accent-700 bg-accent-50", "text-emerald-700 bg-emerald-50"];

const marqueeWords = SITE.services.flatMap((s) => s.items.map((i) => i.title));
let w = 0;
---

<Base title={SITE.name}>
  <!-- ===== Hero ===== -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div class="container-site grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1fr_1.1fr] lg:py-24">
      <div>
        <p class="fade-up inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-accent-700" style="--delay:0s">
          <span class="h-0.5 w-6 rounded bg-accent-500"></span>{SITE.tagline}
        </p>
        <h1 class="mt-5 text-[clamp(2.4rem,6vw,4.25rem)] font-extrabold leading-[1.04] tracking-tight text-brand-950">
          {headline.map((word) => <span class="rise-word" style={`--i:${w++}`}>{word}&nbsp;</span>)}
          <span class="text-brand-600">
            {highlight.map((word) => <span class="rise-word" style={`--i:${w++}`}>{word}&nbsp;</span>)}
          </span>
        </h1>
        <p class="fade-up mt-5 max-w-lg text-lg text-slate-600" style="--delay:.65s">
          Designed, printed and installed by one team in Addis Ababa — from a box of business cards to a whole fleet of branded vehicles.
        </p>
        <div class="fade-up mt-8 flex flex-wrap gap-3" style="--delay:.8s">
          <a href="/contact/#quote" class="group inline-flex h-13 items-center gap-2 rounded-full bg-brand-600 px-7 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-700">
            Get a free quote <ArrowRight class="size-5 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a href={telHref(mainPhone)} class="inline-flex h-13 items-center gap-2 rounded-full bg-white px-6 font-semibold text-brand-950 ring-1 ring-slate-200 transition hover:ring-brand-300">
            <Phone class="size-5 text-brand-600" /> {mainPhone}
          </a>
        </div>
        <div class="fade-up mt-4 flex flex-wrap gap-2 text-sm" style="--delay:.95s">
          <a href={whatsappHref()} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-emerald-700 px-4 font-medium text-white transition hover:bg-emerald-800"><MessageCircle class="size-4" /> WhatsApp</a>
          <a href={telegramHref()} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-sky-700 px-4 font-medium text-white transition hover:bg-sky-800"><Send class="size-4" /> Telegram</a>
        </div>
      </div>

      <!-- Showcase picture on a brand disc, with floating fact cards -->
      <div class="fade-up relative mx-auto w-full max-w-xl lg:max-w-none" style="--delay:.35s">
        <div class="absolute -right-10 -top-10 -z-10 aspect-square w-4/5 rounded-full bg-brand-100" aria-hidden="true"></div>
        <div class="absolute -bottom-6 -left-6 -z-10 size-24 rounded-3xl bg-accent-400/80" aria-hidden="true"></div>
        <Picture
          src={hero}
          alt="Designer sketching a print layout with the word Printing and cyan, magenta and yellow colour shapes"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 600px, 100vw"
          formats={["webp"]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/11] w-full rounded-[2rem] object-cover shadow-2xl shadow-brand-900/20"
        />
        <div class="float absolute -left-3 top-6 hidden rounded-2xl bg-white px-4 py-3 shadow-xl ring-1 ring-slate-100 sm:block">
          <p class="text-2xl font-extrabold text-brand-700 tabular-nums">{SITE.stats[1]?.value}</p>
          <p class="text-xs font-medium text-slate-500">{SITE.stats[1]?.label}</p>
        </div>
        <div class="float-slow absolute -right-3 bottom-8 hidden rounded-2xl bg-white px-4 py-3 shadow-xl ring-1 ring-slate-100 sm:block">
          <p class="text-2xl font-extrabold text-accent-700 tabular-nums">{SITE.stats[2]?.value}</p>
          <p class="text-xs font-medium text-slate-500">{SITE.stats[2]?.label}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Benefits strip ===== -->
  <section class="border-y border-slate-100 bg-white" aria-label="Why customers choose us">
    <ul class="container-site grid grid-cols-2 gap-x-4 gap-y-5 py-7 lg:grid-cols-4">
      {
        benefits.map(({ icon: Icon, title }, i) => (
          <li class="reveal flex items-center gap-3" style={`--i:${i}`}>
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <Icon class="size-5" aria-hidden="true" />
            </span>
            <span class="text-sm font-semibold text-slate-800">{title}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===== How it works ===== -->
  <section class="py-20 md:py-24" aria-labelledby="process-title">
    <div class="container-site">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">How it works</p>
        <h2 id="process-title" class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-5xl">
          From idea to finished job in <span class="text-brand-600">four steps</span>
        </h2>
        <p class="mt-4 text-slate-600">One team handles everything, so nothing gets lost between the designer, the printer and the installer.</p>
      </div>
      <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          SITE.process.map((step, i) => {
            const Icon = iconFor(stepIcons[i] ?? "check");
            return (
              <li class="reveal group rounded-3xl bg-white p-6 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl" style={`--i:${i}`}>
                <div class:list={["relative flex aspect-[5/2] items-center justify-center rounded-2xl sm:aspect-[4/3]", stepTones[i % 4]]}>
                  <Icon class="size-14 transition-transform duration-500 group-hover:scale-110" stroke-width={1.5} aria-hidden="true" />
                  <span class="absolute left-4 top-3 text-sm font-extrabold tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                </div>
                <h3 class="mt-5 text-lg font-bold text-brand-950">{step.title}</h3>
                <p class="mt-1.5 text-sm text-slate-600">{step.text}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ===== Product marquee ===== -->
  <div class="marquee relative overflow-hidden border-y border-slate-200 bg-slate-50 py-4">
    <!-- Moving content must be pausable (WCAG 2.2.2) -->
    <button
      type="button"
      class="marquee-toggle absolute right-2 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-brand-950 text-white shadow-lg"
      aria-pressed="false"
      aria-label="Pause the moving products strip"
    >
      <Pause class="pause-icon size-4" aria-hidden="true" />
      <Play class="play-icon hidden size-4" aria-hidden="true" />
    </button>
    <div class="marquee-track flex w-max gap-8 whitespace-nowrap text-sm font-bold uppercase tracking-[0.14em] text-brand-950" aria-hidden="true">
      {
        [...marqueeWords, ...marqueeWords].map((word) => (
          <span class="flex items-center gap-8">
            {word}
            <span class="size-1.5 rounded-full bg-accent-500" />
          </span>
        ))
      }
    </div>
  </div>

  <!-- ===== Top categories ===== -->
  <section class="relative isolate overflow-hidden py-20 md:py-28" aria-labelledby="categories-title">
    <div class="absolute -right-40 top-20 -z-10 size-[36rem] rounded-full bg-brand-50" aria-hidden="true"></div>
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
      <div class="grid grid-cols-2 gap-4 sm:gap-5">
        {
          collage.map((s, i) => (
            <a
              href={`/services/#${s.slug}`}
              class:list={[
                "reveal reveal-zoom group relative block overflow-hidden rounded-3xl shadow-lg",
                i === 0 ? "row-span-2 min-h-[22rem] sm:min-h-[30rem]" : "min-h-[10.5rem] sm:min-h-[14.5rem]",
              ]}
              style={`--i:${i}`}
            >
              <div class="zoom-media absolute inset-0">
                <ServicePicture fill photoKey={i === 2 ? "promotional--apparel" : s.slug} icon={s.icon} alt="" tone={(["blue", "orange", "navy"] as const)[i]} size={i === 0 ? "lg" : "sm"} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/85 via-brand-950/10 to-transparent"></div>
              <span class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 p-5 font-bold text-white sm:text-lg">
                {s.title}
                <ArrowUpRight class="size-5 shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
      <div class="reveal">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">Top categories</p>
        <h2 id="categories-title" class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-5xl">
          <span class="text-brand-600">{SITE.services.length} services</span> you can order from one team
        </h2>
        <p class="mt-4 max-w-md text-slate-600">{SITE.description}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            SITE.services.slice(3).map((s) => (
              <li>
                <a href={`/services/#${s.slug}`} class="inline-flex min-h-11 items-center rounded-full bg-white px-4 text-sm font-medium text-slate-700 ring-1 ring-slate-200 transition hover:text-brand-700 hover:ring-brand-300">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/services/" class="mt-8 inline-flex h-12 items-center gap-2 rounded-full bg-brand-600 px-6 font-semibold text-white transition hover:bg-brand-700">
          View all services <ArrowUpRight class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Popular products ===== -->
  <section class="bg-slate-50 py-20 md:py-28" aria-labelledby="popular-title">
    <div class="container-site">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">Popular products</p>
        <h2 id="popular-title" class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-5xl">
          What customers <span class="text-brand-600">order most</span>
        </h2>
        <p class="mt-4 text-slate-600">Send us the size, quantity and deadline — we reply with a proforma.</p>
      </div>
      <ul class="mt-14 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
        {
          popular.map(({ service: s, item }, i) => (
            <li class="reveal" style={`--i:${i % 4}`}>
              <a href={`/services/#${s.slug}`} class="group block h-full rounded-3xl bg-white p-3 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-4">
                <div class="zoom-media overflow-hidden rounded-2xl">
                  <ServicePicture photoKey={`${s.slug}--${item.slug}`} icon={item.icon} alt="" tone={(["blue", "navy", "orange"] as const)[i % 3]} size="sm" />
                </div>
                <div class="px-1 pb-1 pt-4">
                  <p class="text-xs font-semibold text-slate-500">{s.title}</p>
                  <h3 class="mt-1 font-bold leading-snug text-brand-950">{item.title}</h3>
                  <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
                    Ask for a price <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Promo pair -->
      <div class="mt-16 grid gap-5 md:grid-cols-2">
        {
          [
            { s: service("vehicle-branding"), photo: "vehicle-branding", bg: "bg-brand-700", eyebrow: "Moving adverts", text: "text-white", sub: "text-brand-100", btn: "ring-white/60 group-hover:bg-white group-hover:text-brand-800" },
            { s: service("promotional"), photo: "promotional--bags", bg: "bg-accent-500", eyebrow: "For staff & events", text: "text-brand-950", sub: "text-brand-950/80", btn: "ring-brand-950/50 group-hover:bg-brand-950 group-hover:text-white" },
          ].map((p, i) => (
            <a href={`/services/#${p.s.slug}`} class:list={["reveal group relative flex min-h-60 overflow-hidden rounded-3xl", p.bg]} style={`--i:${i}`}>
              <div class="zoom-media absolute inset-y-0 right-0 w-1/2 [mask-image:linear-gradient(to_right,transparent,black_45%)]">
                <ServicePicture fill photoKey={p.photo} icon={p.s.icon} alt="" tone="navy" size="sm" />
              </div>
              <div class:list={["relative flex w-3/5 flex-col justify-center p-7 sm:p-9", p.text]}>
                <p class:list={["text-xs font-bold uppercase tracking-[0.18em]", p.sub]}>{p.eyebrow}</p>
                <h3 class="mt-2 text-2xl font-extrabold leading-tight sm:text-3xl">{p.s.title}</h3>
                <span class:list={["mt-5 inline-flex h-11 w-fit items-center gap-1.5 rounded-full px-5 text-sm font-semibold ring-1 transition", p.btn]}>
                  Explore <ArrowUpRight class="size-4" aria-hidden="true" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Why us ===== -->
  <section class="py-20 md:py-28" aria-labelledby="why-title">
    <div class="container-site">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">Why {SITE.shortName}</p>
        <h2 id="why-title" class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-5xl">
          What makes us <span class="text-brand-600">stand out</span>
        </h2>
      </div>
      <ul class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          reasons.map(({ icon: Icon, title, text }, i) => (
            <li class="reveal flex gap-4" style={`--i:${i % 3}`}>
              <span class:list={["flex size-14 shrink-0 items-center justify-center rounded-full", reasonTones[i % 3]]}>
                <Icon class="size-6" aria-hidden="true" />
              </span>
              <div>
                <h3 class="text-lg font-bold text-brand-950">{title}</h3>
                <p class="mt-1 text-sm text-slate-600">{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== Bulk-order banner ===== -->
  <section class="relative isolate overflow-hidden bg-brand-950 py-20 text-center text-white md:py-28">
    <div class="absolute inset-0 -z-10 opacity-35" aria-hidden="true">
      <ServicePicture fill photoKey="large-format" icon="image" alt="" tone="navy" size="lg" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-950" aria-hidden="true"></div>
    <div class="container-site reveal">
      <p class="text-sm font-semibold text-accent-300">Companies, NGOs, schools & events</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-extrabold tracking-tight sm:text-5xl">Ordering for a whole team, branch network or event?</h2>
      <p class="mx-auto mt-4 max-w-xl text-brand-100">Send one list — signs, banners, uniforms and giveaways — and get one proforma for everything.</p>
      <a href="/contact/#quote" class="mt-9 inline-flex h-13 items-center gap-2 rounded-full bg-accent-500 px-8 font-semibold text-brand-950 shadow-xl shadow-accent-500/20 transition hover:bg-accent-400">
        Request a bulk quote <ArrowUpRight class="size-5" />
      </a>
    </div>
  </section>

  <!-- ===== Numbers ===== -->
  {
    SITE.stats.length > 0 && (
      <section class="py-16 md:py-20" aria-label="Team Advert in numbers">
        <div class="container-site">
          <dl class="grid grid-cols-3 gap-2 rounded-3xl bg-white px-4 py-10 text-center shadow-xl shadow-slate-200/70 ring-1 ring-slate-100 sm:py-12">
            {SITE.stats.map((s, i) => (
              <div class="reveal flex flex-col-reverse px-1" style={`--i:${i}`}>
                <dt class="mt-2 text-xs font-medium text-slate-500 sm:text-sm">{s.label}</dt>
                <dd class="text-3xl font-extrabold tracking-tight text-brand-600 tabular-nums sm:text-5xl" data-count={s.value}>
                  {s.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
</Base>
