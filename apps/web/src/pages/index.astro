---
import { Image } from "astro:assets";
import { ArrowRight, CheckCircle2, MessageCircle, Phone, Send } from "@lucide/astro";
import logo from "../assets/teamlogo.png";
import Base from "../layouts/Base.astro";
import ServicePicture from "../components/ServicePicture.astro";
import { SITE, telegramHref, telHref, whatsappHref } from "../content/site";

const [mainPhone] = SITE.contact.phones;
const tones = ["blue", "orange", "navy"] as const;
---

<Base title={SITE.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-700 text-white">
    <div class="absolute -right-32 -top-32 size-[28rem] rounded-full bg-accent-500/25 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 -left-24 size-[26rem] rounded-full bg-brand-400/30 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-10 py-14 md:grid-cols-[1.2fr_1fr] md:py-24">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">{SITE.tagline}</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Make your business impossible to miss.</h1>
        <p class="mt-5 max-w-xl text-lg text-brand-100">Signs, banners, vehicle branding and print — designed, produced and installed by one team, on time.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/#quote" class="inline-flex h-12 items-center gap-2 rounded-lg bg-accent-500 px-6 font-semibold text-white shadow-lg shadow-accent-500/20 hover:bg-accent-600">
            Get a free quote <ArrowRight class="size-4" />
          </a>
          <a href={telHref(mainPhone)} class="inline-flex h-12 items-center gap-2 rounded-lg bg-white/10 px-5 font-semibold text-white ring-1 ring-white/25 hover:bg-white/20">
            <Phone class="size-4" /> {mainPhone}
          </a>
        </div>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a href={whatsappHref()} rel="noopener" target="_blank" class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/90 px-3 py-1.5 font-medium hover:bg-emerald-500"><MessageCircle class="size-4" /> WhatsApp</a>
          <a href={telegramHref()} rel="noopener" target="_blank" class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/90 px-3 py-1.5 font-medium hover:bg-sky-500"><Send class="size-4" /> Telegram</a>
        </div>
      </div>
      <div class="hidden justify-center md:flex">
        <div class="rounded-full bg-white p-6 shadow-2xl">
          <Image src={logo} alt={`${SITE.name} logo`} width={260} height={260} class="size-64" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  {
    SITE.stats.length > 0 && (
      <section class="border-b border-slate-200 bg-white">
        <dl class="container-site grid grid-cols-3 gap-4 py-8 text-center md:py-10">
          {SITE.stats.map((s) => (
            <div>
              <dd class="text-2xl font-bold text-brand-700 sm:text-4xl">{s.value}</dd>
              <dt class="mt-1 text-xs text-slate-500 sm:text-sm">{s.label}</dt>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Services -->
  <section class="bg-slate-50 py-16 md:py-24" aria-labelledby="services-title">
    <div class="container-site">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="services-title" class="text-3xl font-bold tracking-tight">What we do</h2>
          <p class="mt-3 text-slate-600">From a single banner to a full brand rollout across your branches and fleet.</p>
        </div>
        <a href="/services/" class="inline-flex items-center gap-1 font-semibold text-brand-600 hover:underline">All services <ArrowRight class="size-4" /></a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SITE.services.map((s, i) => (
            <a href={`/services/#${s.slug}`} class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <ServicePicture photoKey={s.slug} icon={s.icon} alt={s.title} tone={tones[i % 3]} />
              <div class="p-5">
                <h3 class="text-lg font-semibold group-hover:text-brand-700">{s.title}</h3>
                <p class="mt-1.5 text-sm text-slate-600">{s.summary}</p>
                <p class="mt-3 text-xs font-medium text-slate-500">{s.items.length} options · {s.items.slice(0, 2).map((x) => x.title).join(", ")}…</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 md:py-24" aria-labelledby="process-title">
    <div class="container-site">
      <h2 id="process-title" class="text-3xl font-bold tracking-tight">How it works</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-4">
        {
          SITE.process.map((step, i) => (
            <li class="rounded-2xl border border-slate-200 p-6">
              <span class="flex size-10 items-center justify-center rounded-full bg-accent-500 font-bold text-white">{i + 1}</span>
              <h3 class="mt-4 font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-brand-950 py-16 text-white md:py-20">
    <div class="container-site grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">One partner from design to installation</h2>
        <p class="mt-4 text-slate-300">8+ years and more than 42,000 jobs: you deal with one team that designs, prints and installs — so colours match, deadlines hold and you always know who to call.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          ["In-house designers", "Clear proformas with VAT", "Quality materials", "Installation included", "On-time delivery", "Support after the job"].map((point) => (
            <li class="flex items-center gap-2 rounded-lg bg-white/5 px-4 py-3 text-sm">
              <CheckCircle2 class="size-5 shrink-0 text-accent-400" /> {point}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20">
    <div class="container-site">
      <div class="flex flex-col items-start gap-6 rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 p-8 text-white md:flex-row md:items-center md:justify-between md:p-12">
        <div>
          <h2 class="text-2xl font-bold md:text-3xl">Have a project in mind?</h2>
          <p class="mt-2 text-brand-100">Tell us the size, quantity and deadline — we'll send a proforma.</p>
        </div>
        <a href="/contact/#quote" class="inline-flex h-12 shrink-0 items-center gap-2 rounded-lg bg-accent-500 px-6 font-semibold text-white hover:bg-accent-600">Request a quote <ArrowRight class="size-4" /></a>
      </div>
    </div>
  </section>
</Base>
