---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { SITE, ready } from "../content/site";

const paragraphs = SITE.about.map(ready).filter(Boolean) as string[];
---

<Base title="About us – printing & signage in Addis Ababa" description={`About ${SITE.name}: an advertising, branding and printing company on Gabon St, Kirkos, Addis Ababa, Ethiopia.`}>
  <PageHero eyebrow={`About ${SITE.shortName}`} title="Advertising, branding and printing" highlight="in Addis Ababa" />

  <section class="py-14 md:py-20" aria-label="Our story">
    <div class="container-site grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-center">
      <div class="reveal max-w-2xl space-y-4 text-lg leading-relaxed text-slate-700">
        {paragraphs.length ? paragraphs.map((p) => <p>{p}</p>) : <p>{SITE.description}</p>}
      </div>
      {
        SITE.stats.length > 0 && (
          <dl class="reveal grid grid-cols-3 gap-2 rounded-3xl bg-white px-4 py-8 text-center shadow-xl shadow-slate-200/70 ring-1 ring-slate-100 lg:grid-cols-1 lg:gap-8 lg:py-10">
            {SITE.stats.map((s) => (
              <div class="flex flex-col-reverse px-1">
                <dt class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">{s.label}</dt>
                <dd class="text-2xl font-extrabold tracking-tight text-brand-600 tabular-nums sm:text-4xl" data-count={s.value}>
                  {s.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section class="bg-slate-50 py-16 md:py-20" aria-labelledby="process-title">
    <div class="container-site">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">How we work</p>
        <h2 id="process-title" class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-4xl">
          From idea to finished job in <span class="text-brand-600">four steps</span>
        </h2>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <CtaBand title="Ready to start your project?" text="Tell us what you need and we'll reply with a clear proforma." />
</Base>
