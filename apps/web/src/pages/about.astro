---
import { Image } from "astro:assets";
import logo from "../assets/teamlogo.png";
import Base from "../layouts/Base.astro";
import { SITE, ready } from "../content/site";

const paragraphs = SITE.about.map(ready).filter(Boolean) as string[];
---

<Base title="About us" description={`About ${SITE.name}: an advertising, branding and printing company in Addis Ababa, Ethiopia.`}>
  <section class="bg-brand-700 py-14 text-white md:py-20">
    <div class="container-site">
      <h1 class="text-4xl font-bold tracking-tight">About {SITE.shortName}</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-100">{SITE.tagline}</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-site grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="max-w-2xl space-y-4 text-lg leading-relaxed text-slate-700">
        {paragraphs.length ? paragraphs.map((p) => <p>{p}</p>) : <p>{SITE.description}</p>}
      </div>
      <Image src={logo} alt={`${SITE.name} logo`} width={220} height={220} class="mx-auto size-52 md:mx-0" />
    </div>
  </section>

  <section class="bg-slate-50 py-14 md:py-20">
    <div class="container-site">
      <h2 class="text-2xl font-bold">How we work</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-4">
        {
          SITE.process.map((step, i) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-6">
              <span class="flex size-9 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">{i + 1}</span>
              <h3 class="mt-3 font-semibold">{step.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
