---
// Questions and answers with FAQPage structured data, so Google and AI assistants (ChatGPT, Gemini, Perplexity,
// Claude) can quote the answers. Closed answers stay in the HTML, so crawlers read them all.
import { ChevronDown } from "@lucide/astro";
import type { Faq } from "../content/seo";
import { SITE, telHref } from "../content/site";

interface Props {
  faqs: Faq[];
  eyebrow?: string;
  title?: string;
  /** Shown after the title in brand blue */
  highlight?: string;
  id?: string;
  class?: string;
}

const { faqs, eyebrow = "Questions & answers", title = "Frequently asked", highlight = "questions", id = "faq", class: className } = Astro.props;
const [phone] = SITE.contact.phones;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<section id={id} class:list={["scroll-mt-24 py-20 md:py-24", className]} aria-labelledby={`${id}-title`}>
  <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-14">
    <div class="reveal">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-700">{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-3 text-3xl font-extrabold tracking-tight text-brand-950 sm:text-4xl">
        {title} <span class="text-brand-600">{highlight}</span>
      </h2>
      <p class="mt-4 text-slate-600">
        Something else? Call <a href={telHref(phone)} class="font-semibold text-brand-700 underline-offset-2 hover:underline">{phone}</a> or
        <a href="/contact/#quote" class="font-semibold text-brand-700 underline-offset-2 hover:underline">send us your question</a>.
      </p>
    </div>
    <div class="space-y-3">
      {
        faqs.map((f, i) => (
          <details class="reveal group rounded-2xl bg-white ring-1 ring-slate-200 transition open:shadow-lg open:ring-brand-300" style={`--i:${i % 4}`} open={i === 0}>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 [&::-webkit-details-marker]:hidden">
              <h3 class="text-base font-semibold text-brand-950">{f.q}</h3>
              <ChevronDown class="size-5 shrink-0 text-brand-600 transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <p class="px-5 pb-5 text-slate-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
