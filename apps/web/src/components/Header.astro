---
import { Image } from "astro:assets";
import { Mail, MapPin, Menu, Phone, X } from "@lucide/astro";
import logo from "../assets/teamlogo.png";
import { SITE, telHref, telegramHref, whatsappHref } from "../content/site";

const [mainPhone] = SITE.contact.phones;

const links = [
  { href: "/services/", label: "Services" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---

<!-- Contact bar: scrolls away; the header below stays pinned -->
<aside class="bg-brand-950 text-xs text-brand-100" aria-label="Quick contact">
  <div class="container-site flex h-10 items-center gap-5">
    <a href={telHref(mainPhone)} class="inline-flex min-h-10 items-center gap-1.5 hover:text-white"><Phone class="size-3.5 text-accent-400" aria-hidden="true" />{mainPhone}</a>
    <a href={`mailto:${SITE.contact.email}`} class="hidden min-h-10 items-center gap-1.5 hover:text-white sm:inline-flex"><Mail class="size-3.5 text-accent-400" aria-hidden="true" />{SITE.contact.email}</a>
    <a href={SITE.contact.mapUrl} target="_blank" rel="noopener" class="hidden min-h-10 items-center gap-1.5 hover:text-white lg:inline-flex"><MapPin class="size-3.5 text-accent-400" aria-hidden="true" />{SITE.contact.address}, {SITE.contact.city}</a>
    <span class="ml-auto flex items-center gap-4 font-medium">
      <a href={whatsappHref()} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center hover:text-white">WhatsApp</a>
      <a href={telegramHref()} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center hover:text-white">Telegram</a>
    </span>
  </div>
</aside>

<header class="site-header sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur transition-[box-shadow,background-color] duration-300">
  <div class="container-site flex h-16 items-center gap-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2, 3]} class="size-10" loading="eager" />
      <span class="text-sm font-bold tracking-wide text-brand-700">TEAM ADVERT</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class:list={["rounded-lg px-3 py-2 text-sm font-medium", active(l.href) ? "text-brand-700" : "text-slate-600 hover:text-slate-900"]} aria-current={active(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href="/contact/#quote" class="ml-2 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-brand-950 shadow-sm hover:bg-accent-600">Get a quote</a>
    </nav>

    <!-- Phone menu: <details> works without JavaScript -->
    <details class="group ml-auto md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <Menu class="size-6 group-open:hidden" />
        <X class="hidden size-6 group-open:block" />
      </summary>
      <nav class="absolute inset-x-0 top-16 border-b border-slate-200 bg-white px-4 pb-4 shadow-lg" aria-label="Main">
        {
          links.map((l) => (
            <a href={l.href} class:list={["block rounded-lg px-3 py-3 text-base font-medium", active(l.href) ? "bg-brand-50 text-brand-700" : "text-slate-700"]}>
              {l.label}
            </a>
          ))
        }
        <a href="/contact/#quote" class="mt-2 block rounded-lg bg-accent-500 px-3 py-3 text-center text-base font-semibold text-brand-950">Get a quote</a>
      </nav>
    </details>
  </div>
</header>
