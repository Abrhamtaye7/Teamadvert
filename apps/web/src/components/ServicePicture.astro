---
// A service or sub-service picture: the real photo from src/assets/services/<key>.(jpg|jpeg|png|webp) if one
// exists, otherwise a branded illustration built from the icon. Rendered at build time — no JavaScript.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import * as Icons from "@lucide/astro";

interface Props {
  /** "<service-slug>" or "<service-slug>--<sub-slug>" */
  photoKey: string;
  icon: string;
  alt: string;
  tone?: "blue" | "orange" | "navy";
  size?: "lg" | "sm";
  class?: string;
}

const { photoKey, icon, alt, tone = "blue", size = "lg", class: className } = Astro.props;

const photos = import.meta.glob<ImageMetadata>("../assets/services/*.{jpg,jpeg,png,webp}", { eager: true, import: "default" });
const photo = Object.entries(photos).find(([path]) => path.split("/").pop()!.replace(/\.\w+$/, "") === photoKey)?.[1];

// "panel-top" → "PanelTop", "building-2" → "Building2"
const componentName = icon.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase());
const Icon = (Icons as unknown as Record<string, typeof Icons.Image>)[componentName] ?? Icons.Image;

const tones = {
  blue: "from-brand-500 to-brand-800",
  orange: "from-accent-400 to-accent-600",
  navy: "from-brand-800 to-brand-950",
};
---

{
  photo ? (
    <Picture
      src={photo}
      alt={alt}
      widths={size === "lg" ? [480, 800, 1200] : [320, 480]}
      sizes={size === "lg" ? "(min-width: 1024px) 560px, 100vw" : "(min-width: 768px) 240px, 50vw"}
      formats={["webp"]}
      class:list={["aspect-[4/3] w-full object-cover", className]}
    />
  ) : (
    <div role="img" aria-label={alt} class:list={["relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br", tones[tone], className]}>
      <div class="absolute inset-0 opacity-20 [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:14px_14px]" />
      <div class="absolute -right-8 -top-8 size-32 rounded-full bg-white/15" />
      <div class="absolute -bottom-10 -left-6 size-28 rounded-full bg-black/10" />
      <div class="absolute inset-0 flex items-center justify-center">
        <span class:list={["rounded-2xl bg-white/15 ring-1 ring-white/30 backdrop-blur-sm", size === "lg" ? "p-6" : "p-3.5"]}>
          <Icon class:list={["text-white", size === "lg" ? "size-16" : "size-9"]} stroke-width={1.6} aria-hidden="true" />
        </span>
      </div>
    </div>
  )
}
