---
import { Clock, Mail, MapPin, Phone } from "@lucide/astro";
import { SITE, fullAddress, ready, telHref } from "../content/site";

const c = SITE.contact;
const hours = ready(c.hours);
const socials = Object.entries(SITE.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-slate-300">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-semibold text-white">{SITE.name}</p>
      <p class="mt-2 max-w-sm text-sm">{SITE.description}</p>
      {
        socials.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2 text-sm">
            {socials.map(([name, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center rounded-full bg-white/10 px-4 capitalize hover:bg-white/20 hover:text-white">
                  {name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div>
      <p class="text-sm font-semibold text-white">Contact</p>
      <ul class="mt-3 space-y-1 text-sm">
        {c.phones.map((p) => <li class="flex items-center gap-2"><Phone class="mt-0.5 size-4 shrink-0" /><a href={telHref(p)} class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">{p}</a></li>)}
        <li class="flex items-center gap-2"><Mail class="mt-0.5 size-4 shrink-0" /><a href={`mailto:${c.email}`} class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">{c.email}</a></li>
        <li class="flex items-center gap-2"><MapPin class="mt-0.5 size-4 shrink-0" /><a href={c.mapUrl || "/contact/"} rel="noopener" target={c.mapUrl ? "_blank" : undefined} class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">{fullAddress()}</a></li>
        {hours && <li class="flex gap-2"><Clock class="mt-0.5 size-4 shrink-0" />{hours}</li>}
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">Company</p>
      <ul class="mt-3 space-y-1 text-sm">
        <li><a href="/services/" class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">Services</a></li>
        <li><a href="/about/" class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">About us</a></li>
        <li><a href="/contact/#quote" class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">Request a quote</a></li>
        <li><a href="/faq/" class="inline-flex min-h-11 items-center hover:text-white md:min-h-8">FAQ</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-slate-400 sm:flex-row sm:justify-between">
      <!-- Staff app (/office/) is reached by typing its address; it is not linked from the public site -->
      <p>
        © {year} <a href="https://razielcc.com/" rel="noopener" target="_blank" class="font-medium text-slate-300 underline-offset-2 hover:text-white hover:underline">RCC </a> &amp; {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
