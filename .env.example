# Copy to .env and adjust. Never commit .env.

# Local: docker compose database. On cPanel: the PostgreSQL database/user you create there,
# e.g. postgres://cpuser_teamadvert:PASSWORD@localhost:5432/cpuser_teamadvert
DATABASE_URL=postgres://teamadvert:teamadvert@127.0.0.1:5433/teamadvert
TEST_DATABASE_URL=postgres://teamadvert:teamadvert@127.0.0.1:5433/teamadvert_test

# PIN for the first admin user created by `npm run db:seed` (4 digits). Change it after first login.
SEED_ADMIN_PIN=

# Optional
# PORT=4000
# SESSION_IDLE_MINUTES=120          # auto logout after inactivity
# SESSION_MAX_HOURS=12
# BACKUP_DIR=backups                # on cPanel use a folder OUTSIDE public_html, e.g. /home/teamadub/backups
# CBE_BASE_URL=https://apps.cbe.com.et:100/?id=
# CBE_ACCOUNT_SUFFIX=57045219
# PUBLIC_URL=https://teamadvertplc.com   # links in Telegram messages and the bot's webhook address

# Telegram bot (optional; see docs/SETUP.md §7). Leave TELEGRAM_BOT_TOKEN empty to turn the bot off.
# TELEGRAM_BOT_TOKEN=                    # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=               # 16+ random letters/digits, e.g. `openssl rand -hex 24`
# TELEGRAM_USERS=                        # who may use it and as which office user: 123456789:admin,987654321:sara
